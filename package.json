{
  "name": "ali-course-platform",
  "version": "1.0.0",
  "description": "منصة الكورسات المسجلة - علي عباس",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "npx pm2-runtime ecosystem.config.js",
    "dev": "nodemon server.js",
    "cap:add:ios": "node build_cap_www.js && npx cap add ios",
    "cap:add:android": "node build_cap_www.js && npx cap add android",
    "cap:sync": "node build_cap_www.js && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "pm2": "^6.0.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "nodemon": "^3.0.1"
  }
}
